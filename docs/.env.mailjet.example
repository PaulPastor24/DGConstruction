# Attendance reports use Mailjet; other application mail settings may stay as-is.
ATTENDANCE_REPORT_MAILER=mailjet
MAILJET_HOST=in-v3.mailjet.com
MAILJET_PORT=587
MAILJET_SCHEME=smtp
# SMTP username is the API key; SMTP password is the secret key.
MAILJET_API_KEY=replace_with_mailjet_api_key
MAILJET_SECRET_KEY=replace_with_mailjet_secret_key
# Must be verified in the same Mailjet account. This is the sender, not the recipient.
MAILJET_FROM_ADDRESS=reports@your-verified-domain.com
MAILJET_FROM_NAME="D&G Construction Reports"
