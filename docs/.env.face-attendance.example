# Keep DISABLED until AWS resources + privacy review + staging tests are complete.
FACE_ATTENDANCE_ENABLED=false
FACE_AWS_REGION=ap-northeast-1
FACE_AWS_COLLECTION_ID=dgconstruction-workers-staging
FACE_AWS_STREAM_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/DGFaceLivenessStreamingRole
FACE_PRIVACY_NOTICE_VERSION=v1
FACE_LIVENESS_THRESHOLD=90
FACE_SIMILARITY_THRESHOLD=98
FACE_AMBIGUITY_MARGIN=5
# Standard AWS SDK credential chain on the server; NEVER prefix with VITE_ and never commit real keys.
AWS_ACCESS_KEY_ID=REPLACE_IN_HOSTINGER_ENV_ONLY
AWS_SECRET_ACCESS_KEY=REPLACE_IN_HOSTINGER_ENV_ONLY
